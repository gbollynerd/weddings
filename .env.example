# Postgres connection (Supabase → Connect → Transaction pooler, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weddings
# Long random string used to sign session cookies
AUTH_SECRET=change-me-to-a-long-random-string
# Optional — enables real file storage in Supabase Storage (otherwise uploads are mocked)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=visual-weddings
