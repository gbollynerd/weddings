# Postgres connection (Supabase → Connect → Transaction pooler, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weddings
# Long random string used to sign session cookies
AUTH_SECRET=change-me-to-a-long-random-string
# Optional — enables real file storage in Supabase Storage (otherwise uploads are mocked)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=visual-weddings
# Optional — store uploads in the company Dropbox instead (takes priority over Supabase Storage).
# Create an app at dropbox.com/developers/apps (Scoped access, App folder), then run scripts/dropbox-auth.ts.
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_ROOT=/Weddings
